# ==========================================
# Project Zomboid Server Dashboard - Environment Configuration
# ==========================================

# Server Host and Port
PORT=3000
HOST=127.0.0.1

# SQLite Database Location
DB_PATH=data/dashboard.db

# Cookie & Session Security
# Set COOKIE_SECURE=true when running behind HTTPS/TLS reverse proxy
COOKIE_SECURE=false

# Session Maximum Age in Milliseconds (Default: 7 days = 604800000)
SESSION_MAX_AGE_MS=604800000

# User Registration Policy
# If true, any visitor can self-register with 'viewer' role.
# If false (recommended for private servers), only admins can create new accounts.
ALLOW_REGISTRATION=false

# Initial Admin Credentials (Optional for automated container deployments)
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@pzserver.local
# ADMIN_PASSWORD=ChangeMe123!
